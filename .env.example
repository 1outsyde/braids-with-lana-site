# ── Public (exposed to browser) ──────────────────────────────────────────────
# Backend API base URL (no trailing slash)
NEXT_PUBLIC_OUTSYDE_API_URL=https://api.goutsyde.com

# Business UUID for Braids by Lana.
# lib/config.ts reads NEXT_PUBLIC_OUTSYDE_BUSINESS_ID.
# lib/outsyde.ts falls back to NEXT_PUBLIC_BUSINESS_ID when the above is unset,
# so setting only NEXT_PUBLIC_OUTSYDE_BUSINESS_ID covers both files.
NEXT_PUBLIC_OUTSYDE_BUSINESS_ID=<business-uuid>
NEXT_PUBLIC_BUSINESS_ID=<business-uuid>   # set to the same value as above

# Canonical URL for this deployment (used in sitemaps, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=https://braidsbylana.com

# Stripe publishable key (used on /book page to initialise Stripe.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Server-only (never exposed to browser) ───────────────────────────────────
# Same API base URL, read by Next.js BFF routes (app/api/**).
OUTSYDE_API_URL=https://api.goutsyde.com

# Same business UUID, read by Next.js BFF routes.
OUTSYDE_BUSINESS_ID=<business-uuid>

# Internal API key forwarded on media upload requests (optional; leave blank to omit).
INTERNAL_API_KEY=
